# Base URL of the Mezgab Express API.
# Local development: leave unset (defaults to http://localhost:4000/api).
# Production (Vercel): set VITE_API_BASE_URL to your deployed API, or leave unset
# to call the same origin at /api.
# VITE_API_BASE_URL=http://localhost:4000/api

# Supabase project credentials (publishable / anon key only - NEVER a service-role key)
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
