# Server
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Supabase
# Prefer the publishable key so that Row Level Security stays in force
# for authenticated user requests. Never expose the service-role key to clients.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Service-role key: server-only, use sparingly for privileged/admin tasks.
# Required to auto-promote ADMIN_EMAILS accounts to administrator on first login.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated email addresses that are treated as administrators and are
# promoted automatically (needs the service-role key). Leave empty and grant the
# role manually instead:
#   update public.profiles set role = 'admin' where email = 'you@example.com';
ADMIN_EMAILS=
